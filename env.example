# Copy this file to .env and adjust. Values here only seed the server
# config the FIRST time it starts (empty volume) and set dashboard access -
# after that, change track/weather/server name etc. from the web dashboard.
#
# NOTE for QNAP Container Station GUI users: the GUI's "Create Application"
# import does NOT read .env files - it only understands the docker-compose.yml
# text you paste in. The ${VAR:-default} entries below still work there (they
# just fall back to the default shown), so if you're deploying via the GUI,
# edit these values directly into the pasted YAML instead of using this file.
# See README.md's QNAP section.

# --- where persistent data (cfg/results/logs) is stored on the host ---
# REQUIRED - there is no default, on purpose, since a path that happens to
# exist on one machine may not exist (or mean something else) on another.
# Bind-mounted so it shows up in File Station / a regular file browser -
# create this folder first.
#   QNAP example:      /share/Container/acc-server
#   Plain Linux example: /home/youruser/acc-server
DATA_PATH=

# --- dashboard access - CHANGE THESE ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme
FLASK_SECRET_KEY=please-change-this-to-a-random-string
DASHBOARD_PORT=8080

# --- whether the game server launches automatically on container start ---
AUTO_START=true

# --- initial server identity ---
SERVER_NAME=My ACC Server
ADMIN_PASSWORD=changeme_admin
SERVER_PASSWORD=
SPECTATOR_PASSWORD=

# --- initial network ---
TCP_PORT=9231
UDP_PORT=9231
MAX_CONNECTIONS=30
REGISTER_TO_LOBBY=true

# --- initial track & session ---
TRACK=monza
CAR_GROUP=FreeForAll
MAX_CAR_SLOTS=26

# --- initial weather ---
AMBIENT_TEMP=22
CLOUD_LEVEL=0.3
RAIN=0.0
WEATHER_RANDOMNESS=1
